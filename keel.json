{
  "keel": 1,
  "name": "tally",
  "profile": "electron-web",
  "platforms": {
    "tier1": [
      "windows-x64",
      "macos-arm64",
      "linux-x64"
    ],
    "tier2": [],
    "tier3": []
  },
  "commands": {
    "lint": "npm run typecheck",
    "unit": "npm run test:unit",
